{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "includeFiles": "build/mcp/**"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/errors/:slug",
      "destination": "/errors?missing=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/cookbook/incident-copilot",
      "destination": "/cookbook/oncall-copilot",
      "permanent": true
    },
    {
      "source": "/guides/chat/chatbot-example",
      "destination": "/cookbook/streaming-chat-with-citations",
      "permanent": true
    },
    {
      "source": "/client/guides/chatbot",
      "destination": "/cookbook/streaming-chat-with-citations",
      "permanent": true
    },
    {
      "source": "/guides/tools/overview",
      "destination": "https://docs.glean.com/administration/tools/",
      "permanent": true
    },
    {
      "source": "/guides/tools/examples/zendesk-ticket-redirection",
      "destination": "https://docs.glean.com/administration/tools/setup-tools/redirect-tools",
      "permanent": true
    },
    {
      "source": "/guides/tools/examples/google-docs-update",
      "destination": "https://docs.glean.com/tools/connector/google-docs-tools",
      "permanent": true
    },
    {
      "source": "/guides/tools/examples/jira-issue-creation-redirect",
      "destination": "https://docs.glean.com/administration/tools/setup-tools/redirect-tools",
      "permanent": true
    },
    {
      "source": "/guides/tools/examples/jira-issue-creation",
      "destination": "https://docs.glean.com/tools/connector/jira/create-issue",
      "permanent": true
    },
    {
      "source": "/guides/chat/overview",
      "destination": "/api/platform-api/chat-overview",
      "permanent": true
    },
    {
      "source": "/guides/search/overview",
      "destination": "/api/platform-api/search-overview",
      "permanent": true
    }
  ]
}
