{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "includeFiles": "build/mcp/**"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/errors/:slug",
      "destination": "/errors?missing=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/cookbook/incident-copilot",
      "destination": "/cookbook/oncall-copilot",
      "permanent": true
    }
  ]
}
