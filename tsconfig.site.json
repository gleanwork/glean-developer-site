{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom", "@docusaurus/module-type-aliases"],
    "paths": {
      "@site/*": ["./*"],
      "@theme/Markdown": ["./src/types/theme-markdown.d.ts"],
      "@theme/SchemaTabs": ["./src/types/theme-schema-tabs.d.ts"],
      "@theme/*": [
        "./src/theme/*",
        "./packages/docusaurus-theme-glean/src/theme/*",
        "./node_modules/docusaurus-theme-openapi-docs/lib/theme/*"
      ]
    }
  },
  "include": ["docusaurus.config.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    ".docusaurus",
    "build",
    "packages",
    "snippets",
    "src/**/*.test.*",
    "src/test/**"
  ]
}
